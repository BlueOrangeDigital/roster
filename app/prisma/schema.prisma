generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["roster", "platform"]
}

enum UserRole {
  ADMIN
  REVIEWER

  @@schema("roster")
}

enum ReviewStatus {
  NOT_REVIEWED
  REQUEST_INTERVIEW
  NOT_INTERESTED

  @@schema("roster")
}

// User model stays UNCHANGED in /prepare-app — auth code depends on role/password fields.
// The full User model swap (removing role/password, adding @@schema("platform") + @@map("users"))
// happens in /import-app alongside auth migration.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(REVIEWER)
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  reviews       Review[]
  magicTokens   MagicToken[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@schema("roster")
}

model MagicToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("roster")
}

model Candidate {
  id                String   @id @default(cuid())
  teamTailorId      String?  @unique
  firstName         String
  lastName          String?
  email             String?
  phone             String?
  pictureUrl        String?
  resumeUrl         String?
  summary           String?  @db.Text
  summaryIsManual   Boolean  @default(false)
  skills            Json     @default("[]")
  experience        Json     @default("[]")
  education         Json     @default("[]")
  certifications    Json     @default("[]")
  linkedinUrl       String?
  tags              Json     @default("[]")
  lastSyncedAt      DateTime?
  assignments       CandidateAssignment[]
  reviews           Review[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@schema("roster")
}

model Company {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  contactEmail String?
  notes        String?  @db.Text
  shareToken   String   @unique @default(cuid())
  isActive     Boolean  @default(true)
  reviewers    User[]
  assignments  CandidateAssignment[]
  roles        Role[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@schema("roster")
}

model CandidateAssignment {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleId          String?
  tailoredSummary String?   @db.Text
  role            Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  reviews         Review[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([candidateId, companyId, roleId])
  @@index([roleId])
  @@schema("roster")
}

model Review {
  id           String       @id @default(cuid())
  status       ReviewStatus @default(NOT_REVIEWED)
  feedback     String?      @db.Text
  reviewerId   String
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   CandidateAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([reviewerId, candidateId, assignmentId])
  @@schema("roster")
}

model TeamTailorConfig {
  id          String   @id @default(cuid())
  apiKey      String
  apiRegion   String   @default("eu")
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("roster")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments CandidateAssignment[]

  @@schema("roster")
}
